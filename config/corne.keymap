#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/rgb.h>

&led_strip {
    chain-length = <27>;
};

/ {
    keymap {
        compatible = "zmk,keymap";

        base_layer {
            label = "BASE";
            bindings = <
&kp ESC    &kp Q &kp W &kp E &kp R &kp T   &kp Y &kp U &kp I     &kp O   &kp P      &kp BSPC
&kp TAB    &kp A &kp S &kp D &kp F &kp G   &kp H &kp J &kp K     &kp L   &kp AT     &kp RET
&kp LSHIFT &kp Z &kp X &kp C &kp V &kp B   &kp N &kp M &kp EXCL  &kp DOT &kp QMARK  &kp DEL
               &kp LEFT_CONTROL &mo 2 &kp SPACE   &kp LWIN &mo 1 &kp LEFT_ALT
            >;
        };

        symbols_layer {
            label = "SYMBOLS";
            bindings = <
&kp F1   &kp F2    &kp F3   &kp F4    &kp F5       &kp F6         &kp F7          &kp F8          &kp F9          &kp F10         &kp F11         &kp F12
&kp HOME &kp PSCRN &kp UP   &kp END   &bt BT_SEL 1 &bt BT_SEL 2   &rgb_ug RGB_ON  &rgb_ug RGB_HUI &rgb_ug RGB_SAI &rgb_ug RGB_BRI &rgb_ug RGB_SPI &rgb_ug RGB_EFF
&kp INS  &kp LEFT  &kp DOWN &kp RIGHT &bt BT_SEL 3 &bt BT_SEL 4   &rgb_ug RGB_OFF &rgb_ug RGB_HUD &rgb_ug RGB_SAD &rgb_ug RGB_BRD &rgb_ug RGB_SPD &rgb_ug RGB_EFR
                             &bt BT_CLR &kp CLCK &trans   &trans &trans &bt BT_SEL 0
            >;
        };

        nav_layer {
            label = "NAV";
            bindings = <
&kp TILDE &kp HASH &kp DLLR &kp CARET &kp AMPS &kp PIPE   &kp GRAVE &kp N7 &kp N8 &kp N9 &kp PLUS  &kp MINUS
&kp LPAR  &kp RPAR &kp LT   &kp GT    &kp COLON &kp SEMI  &kp UNDER &kp N4 &kp N5 &kp N6 &kp STAR  &kp FSLH
&kp LBKT  &kp RBKT &kp LBRC &kp RBRC  &kp APOS &kp DQT    &kp BSLH  &kp N1 &kp N2 &kp N3 &kp PRCNT &kp EQUAL
                             &kp PG_UP &trans &trans   &trans &kp N0 &kp PG_DN
            >;
        };

        extended_layer {
            label = "EXT";
            bindings = <
&trans &trans &trans &trans &trans &trans   &trans &trans &trans &trans &trans &trans
&trans &trans &trans &trans &trans &trans   &trans &trans &trans &trans &trans &trans
&trans &trans &trans &trans &trans &trans   &trans &trans &trans &trans &trans &trans
                     &trans &trans &trans   &trans &trans &trans
            >;
        };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";
        Activate_EXT {
            if-layers = <1 2>;
            then-layer = <3>;
        };
    };
};
